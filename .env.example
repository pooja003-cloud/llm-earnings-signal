# Copy to .env and fill in. Never commit .env.

# Required: SEC asks every client to identify itself: "Your Name your.email@example.com"
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional, only for llm.provider: anthropic (paid API). Not needed for the
# default claude_code provider (Claude Pro login) or for ollama (free, local).
# ANTHROPIC_API_KEY=sk-ant-...
